ENV=dev

# Kill-switch: broker submits only when exactly "true" (unset/false = dry run)
ENABLE_TRADING=false

# Dashboard: paper/live runs from the UI need explicit opt-in (no auth)
DASHBOARD_ALLOW_BROKER=false

# Alpaca (required for --mode paper|live)
# paper requires https://paper-api.alpaca.markets; live requires https://api.alpaca.markets
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Trading config (hours and weekdays are evaluated in MARKET_TZ)
SYMBOLS=AAPL,MSFT,SPY
TRADING_HOURS=09:30-16:00
MARKET_TZ=America/New_York
MAX_NOTIONAL=2000
STATE_DIR=./state

# LLM scoring (optional; weight 0.0 = shadow / ignored in blend)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=10
LLM_WEIGHT=0.0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
