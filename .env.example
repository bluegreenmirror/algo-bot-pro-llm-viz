#.env.example
ENV=dev

# Alpaca (optional live mode)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Trading config
SYMBOLS=AAPL,MSFT,SPY
TRADING_HOURS=09:30-16:00
MAX_NOTIONAL=2000
STATE_DIR=./state

# LLM scoring (optional)
LLM_PROVIDER=mock    # mock | openai | anthropic
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=10
LLM_WEIGHT=0.0       # 0.0 = disabled (shadow mode); increase to 0.2..0.4 to blend

LLM_PROVIDER=mock         # mock | openai | anthropic
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=10
LLM_WEIGHT=0.0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=